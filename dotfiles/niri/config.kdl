include "animations.kdl"
include "binds.kdl"
include "cursor.kdl"
include "debug.kdl"
include "decorations.kdl"
include "input.kdl"
include "layout.kdl"
include "output.kdl"
include "spawn-at-startup.kdl"
include "window-rules.kdl"

// Written by Noctalia (theme templates) - focus ring / border colors.
// Absent until Noctalia renders once on first login; niri logs a warning
// and continues.
include "noctalia.kdl"

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

hotkey-overlay {
    // Disabled: on krieger this was showing up in Moonlight/Sunshine
    // streams from the HDMI dummy plug (new-output-connect also triggers
    // it, not just niri's own startup) - fine to skip everywhere.
    skip-at-startup
}
