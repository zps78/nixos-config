// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.

// This line starts waybar, a commonly used bar for Wayland compositors.
// spawn-at-startup "waybar"
// Noctalia is the bar/shell (and the polkit agent, via
// programs.noctalia.settings.shell.polkit_agent). It runs as a systemd
// user service now - see programs.noctalia.systemd.enable in home/niri.nix -
// so it is NOT spawned here.

// Inhibit idle while docked (>1 output connected). Only present when
// myDesktop.idle.enable = true; a no-op otherwise.
spawn-sh-at-startup "test -x $HOME/.config/niri/scripts/idle-monitor.sh && exec $HOME/.config/niri/scripts/idle-monitor.sh"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"
