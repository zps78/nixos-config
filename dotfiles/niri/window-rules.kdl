// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
//window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
//    match app-id=r#"^org\.wezfurlong\.wezterm$"#
//    default-column-width {}
//}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Rounded corners for all windows.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Subtle depth cue: dim windows that aren't focused. Tune 1.0 = off.
// (This dims text too, not just the background - lower with care.)
window-rule {
    match is-active=false
    opacity 0.92
}

// niri has no compositor-side blur, so translucency won't be frosted.
// Terminal transparency is done in ghostty itself (background-opacity in
// home/common.nix) so text stays fully opaque.

// xwayland-satellite doesn't handle X11 apps that request absolute screen
// positioning well (documented niri limitation) - small centered dialogs
// hit this and can collapse to ~1px tall OR ~1px wide (seen both ways:
// Inno Setup's "Select Setup Language" popup collapsed to a thin
// horizontal line via Bottles/UMU/Proton; a DODI installer's "Setup"
// window collapsed to a thin vertical sliver via Lutris/UMU/GE-Proton -
// same underlying bug, different axis). "steam_app_default" is the
// generic app-id XWayland assigns to Proton/Steam/UMU windows; these are
// floors only, so real game windows are unaffected.
window-rule {
    match app-id=r#"^steam_app_default$"#
    min-height 200
    min-width 200
}

// krieger only in practice (HDMI-A-1 only exists there, the Sunshine
// dummy plug - see hosts/krieger/niri/output.kdl) - Steam Big Picture,
// launched via Moonlight/Sunshine, was opening on whatever output niri
// last had focused (a real monitor, not the dummy plug being streamed)
// and tiled at half-width instead of fullscreen. open-on-output pins it
// correctly regardless of prior focus (more robust than trying to focus
// the right output before launch, which sunshine's apps.json prep-cmd
// also does as a second line of defense). Title-matched, not app-id, so
// this doesn't force-fullscreen the regular Steam client window too.
window-rule {
    match app-id=r#"^steam$"# title=r#"^Steam Big Picture Mode$"#
    open-on-output "HDMI-A-1"
    open-fullscreen true
}

// WinApps (FreeRDP RemoteApp/RAIL) windows: same underlying clash as
// steam_app_default above (xwayland-satellite + absolute-positioned X11
// windows). Tried open-floating first - made it worse, reproducibly
// crashing xwayland-satellite (X connection to :0 broken) right at the
// RAIL window-order negotiation stage, every single launch. Reverted to
// the same min-size floor used for Steam instead, which doesn't touch
// niri's placement/floating logic at all. "Microsoft Excel" confirmed
// via `niri msg windows`; add further entries here as other WinApps
// apps (cmd, explorer, etc.) get used and hit the same issue - their
// app-ids are each app's FULL_NAME, set via winapps' own /wm-class flag.
window-rule {
    match app-id=r#"^Microsoft Excel$"#
    min-height 200
    min-width 200
}
