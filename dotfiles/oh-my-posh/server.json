{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#6799e4",
          "foreground": "#181d25",
          "options": {
            "alpine": "",
            "arch": "",
            "centos": "",
            "debian": "",
            "elementary": "",
            "fedora": "",
            "gentoo": "",
            "linux": "",
            "macos": "",
            "manjaro": "",
            "mint": "",
            "opensuse": "",
            "raspbian": "",
            "ubuntu": "",
            "windows": ""
          },
          "style": "diamond",
          "leading_diamond": "╭─",
          "template": " {{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#1f2733",
          "foreground": "#afb2b6",
          "style": "powerline",
          "powerline_symbol": "",
          "template": " {{.UserName}}@{{.HostName}} ",
          "type": "session"
        },
        {
          "background": "#685cd6",
          "foreground": "#e9f1fc",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "folder_separator_icon": " <transparent></> "
          },
          "style": "powerline",
          "powerline_symbol": "",
          "template": " {{.Path}} ",
          "type": "path"
        },
        {
          "background": "#a366cc",
          "foreground": "#141820",
          "background_templates": [
            "{{if or (.Working.Changed) (.Staging.Changed)}}#fd4663{{end}}",
            "{{if and (gt .Ahead 0) (gt .Behind 0)}}#616871{{end}}",
            "{{if gt .Ahead 0}}#6799e4{{end}}",
            "{{if gt .Behind 0}}#6799e4{{end}}"
          ],
          "options": {
            "branch_template": "{{trunc 25 .Branch}}",
            "fetch_status": true,
            "branch_icon": " ",
            "branch_identical_icon": "",
            "branch_gone_icon": ""
          },
          "style": "diamond",
          "leading_diamond": "<transparent,background></>",
          "template": " {{.HEAD}}{{if .BranchStatus}} {{.BranchStatus}}{{end}}{{if .Working.Changed}} <transparent></> <#121318> {{.Working.String}}</>{{end}}{{if .Staging.Changed}} <transparent></> <#121318> {{.Staging.String}}</>{{end}}{{if gt .StashCount 0}} <transparent></> <#121318> {{.StashCount}}</>{{end}} ",
          "trailing_diamond": "",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#1f2733",
          "foreground": "#afb2b6",
          "options": {
            "style": "austin",
            "always_enabled": true
          },
          "invert_powerline": true,
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{.FormattedMs}} ",
          "type": "executiontime"
        },
        {
          "background": "#6799e4",
          "foreground": "#181d25",
          "options": {
            "time_format": "15:04:05"
          },
          "invert_powerline": true,
          "style": "diamond",
          "template": "  {{.CurrentDate | date .Format}} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#6799e4",
          "style": "plain",
          "template": "╰─ {{if .Root}}#{{else}}${{end}}",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
