// fastfetch on the server text console (home/profiles/server.nix runs it at
// a console login): plain characters and the 16 console colours only - the
// bitmap console font has no Nerd Font glyphs.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "nixos_old_small", "padding": { "top": 1, "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "yellow" },
    "bar": { "char": { "elapsed": "#", "total": "-" }, "width": 12 },
    "percent": { "type": 3 },
    "size": { "binaryPrefix": "jedec" }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "-" },
    { "type": "os",       "key": "OS      " },
    { "type": "kernel",   "key": "Kernel  " },
    { "type": "uptime",   "key": "Uptime  " },
    { "type": "loadavg",  "key": "Load    " },
    { "type": "cpu",      "key": "CPU     ", "temp": true },
    { "type": "gpu",      "key": "GPU     ", "temp": true },
    { "type": "memory",   "key": "Memory  " },
    { "type": "command",  "key": "Pools   ", "text": "zpool list -H -o name,health,capacity 2>/dev/null | awk '{printf \"%s %s %s   \", $1, $2, $3}'" },
    { "type": "localip",  "key": "LAN     ", "namePrefix": "enp", "showIpv4": true, "showIpv6": false, "showPrefixLen": false, "defaultRouteOnly": false },
    { "type": "localip",  "key": "Tailnet ", "namePrefix": "tailscale", "showIpv4": true, "showIpv6": false, "showPrefixLen": false, "defaultRouteOnly": false },
    { "type": "users",    "key": "Users   " }
  ]
}
