// ../../hosts/kimi/niri/output.kdl
// kimi is a headless appliance driven entirely via Sunshine/Moonlight - the
// only "display" is a dummy HDMI EDID-emulator plug (reports itself as
// "PNP(AOC) 28E850", cloning a real monitor's EDID for broad mode support).
// No built-in eDP panel exists on this host - the previous eDP-1 stub was
// never real hardware.
//
// Run `niri msg outputs` (with NIRI_SOCKET set - not exported over a plain
// ssh session, pull it from `systemctl --user show-environment`) to see the
// live connector/mode list if the dummy plug is ever swapped.

output "HDMI-A-2" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}
