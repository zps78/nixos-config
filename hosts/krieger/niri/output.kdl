// ../../hosts/krieger/niri/output.kdl
// krieger is a desktop tower (no built-in eDP panel) - two identical
// Lenovo LT2223pwC 1920x1080 monitors, distinguished only by serial in
// the connector name. Positions inverted from niri's auto-assignment
// per report of L<>R being swapped - flip back if this guessed wrong.
//
// Run `niri msg outputs` (with NIRI_SOCKET set - not exported over a
// plain ssh session, see systemctl --user show-environment) to see the
// live connector/serial mapping if hardware ever changes.

// VN-506623 - now on the right.
output "DP-2" {
    mode "1920x1080@59.934"
    scale 1
    transform "normal"
    position x=1920 y=0
}

// VN-983223 - now on the left.
output "DP-3" {
    mode "1920x1080@59.934"
    scale 1
    transform "normal"
    position x=0 y=0
}

// HDMI dummy plug for Sunshine (always-on render target so niri has an
// active output even with no monitor attached) - not connected yet.
// Once it is, add its real connector name here (`niri msg outputs`),
// and note it won't need a Logical position overlapping the two above
// unless you want it to mirror rather than extend.
// output "HDMI-A-1" {
//     mode "1920x1080@60"
//     scale 1
// }
