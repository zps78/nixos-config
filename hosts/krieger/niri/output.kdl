// ../../hosts/krieger/niri/output.kdl
// krieger is a desktop tower (no built-in eDP panel) - two identical
// Lenovo LT2223pwC 1920x1080 monitors, distinguished only by serial in
// the connector name. Positions inverted from niri's auto-assignment
// per report of L<>R being swapped - flip back if this guessed wrong.
//
// Run `niri msg outputs` (with NIRI_SOCKET set - not exported over a
// plain ssh session, see systemctl --user show-environment) to see the
// live connector/serial mapping if hardware ever changes.

// VN-506623 - now on the right.
output "DP-2" {
    mode "1920x1080@59.934"
    scale 1
    transform "normal"
    position x=1920 y=0
}

// VN-983223 - now on the left.
output "DP-3" {
    mode "1920x1080@59.934"
    scale 1
    transform "normal"
    position x=0 y=0
}

// HDMI dummy plug for Sunshine (always-on render target so niri has an
// active output even with no monitor attached). Arrived and connected
// - identifies itself as "sisel muhendislik 8K1080P@144Hz" (a generic
// EDID-emulator dummy plug, not a real display - the odd vendor string
// and implausibly wide mode list are the tell). Positioned to the
// right of both real monitors (matches niri's own auto-assignment,
// pinned explicitly rather than relied on) so it extends rather than
// mirrors. 1920x1080@60 chosen deliberately over the plug's fancier
// modes (up to 4K/144Hz) - a safe, conservative default for remote
// streaming bandwidth; bump it if Sunshine's own stream quality
// settings want to drive a higher output mode.
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    position x=3840 y=0
}
