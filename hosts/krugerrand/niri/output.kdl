// ../../hosts/krugerrand/niri/output.kdl
// krugerrand is docked to the same Lenovo Thunderbolt 4 Dock + "TriCreate"
// 3-monitor arm kit as kuro, but unlike kuro it can drive all 4 outputs
// (3 external + internal) at once: the dock's 3 arms are wired to the
// NVIDIA dGPU (card0-DP-6/7/8), completely separate from the internal
// panel on the Intel iGPU (card1-eDP-1). Confirmed live via
// /sys/class/drm/card*-*/status while docked - all 4 connected
// simultaneously, no pipe-count ceiling like kuro's iGPU-only setup.
// niri itself supports driving outputs across two separate GPUs this
// way (confirmed via niri-wm/niri#550 on GitHub).
//
// As of 2026-09-22 (initial dock connection): Left and the internal
// panel show a clean image. Middle shows visible graphical artifacts.
// Right shows no image at all. Most likely a bad/marginal cable or
// connector on this specific TriCreate kit - kuro hit an almost
// identical symptom that turned out to be a bad dock cable, fixed by
// swapping it. Worth re-testing after a cable check/reseat and a cold
// boot with everything connected before trusting Middle/Right here.
//
// Run `niri msg outputs` (with NIRI_SOCKET set - not exported over a
// plain ssh session, see systemctl --user show-environment) to see the
// live connector/serial mapping if the dock or cable ever changes;
// connector names (DP-6, DP-7, DP-8 etc.) can shift across reconnects
// even though the monitors themselves are the same.

output "eDP-1" {
    mode "2560x1600@60.001"
    scale 1.2
    transform "normal"
    position x=0 y=0
}

// "RTK TriCreate-L" - Left arm of the 3-monitor kit. Clean image.
output "DP-6" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=2134 y=0
}

// "PNP(TCK) TriCreate-M" - Middle arm. Showing graphical artifacts as
// of the initial connection - likely cable/connector related, not
// this config.
output "DP-8" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=4054 y=0
}

// "PNP(TCK) TriCreate-R" - Right arm. Not producing an image as of the
// initial connection - likely cable/connector related, not this
// config.
output "DP-7" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=5974 y=0
}
