// ../../hosts/krugerrand/niri/output.kdl
// krugerrand is docked to the same Lenovo Thunderbolt 4 Dock + "TriCreate"
// 3-monitor arm kit as kuro, but unlike kuro it can drive all 4 outputs
// (3 external + internal) at once: the dock's 3 arms are wired to the
// NVIDIA dGPU (card0-DP-6/7/8), completely separate from the internal
// panel on the Intel iGPU (card1-eDP-1). Confirmed live via
// /sys/class/drm/card*-*/status while docked - all 4 connected
// simultaneously, no pipe-count ceiling like kuro's iGPU-only setup.
// niri itself supports driving outputs across two separate GPUs this
// way (confirmed via niri-wm/niri#550 on GitHub).
//
// Matched by each output's full descriptive name (make/model/serial),
// not by connector (DP-6/7/8) - confirmed those connector numbers
// actually swap which physical arm they're attached to across reboots
// (Left went DP-6 -> DP-8, Middle went DP-8 -> DP-6, between the
// first dock connection and a later reboot), while the descriptive
// name stayed tied to the correct physical arm both times. Matching
// this way survives that reshuffling.
//
// 2026-09-22 initial connection: Middle had graphical artifacts and
// Right showed no image at all - both resolved after a reboot with
// everything connected, matching the bad-cable pattern kuro hit on
// the same style of kit. All 4 outputs confirmed clean after that.
//
// Run `niri msg outputs` (with NIRI_SOCKET set - not exported over a
// plain ssh session, see systemctl --user show-environment) to see
// the live connector/name mapping if the dock or cable ever changes.

output "eDP-1" {
    mode "2560x1600@60.001"
    scale 1.2
    transform "normal"
    position x=0 y=0
}

// Left arm of the 3-monitor kit.
output "Invalid Vendor Codename - RTK TriCreate-L T3-DP250813" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=2134 y=0
}

// Middle arm of the 3-monitor kit.
output "PNP(TCK) TriCreate-M T3-HDMI250813" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=4054 y=0
}

// Right arm of the 3-monitor kit.
output "PNP(TCK) TriCreate-R T3-HDMI250813" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=5974 y=0
}
