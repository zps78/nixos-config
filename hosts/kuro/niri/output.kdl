// ../../hosts/kuro/niri/output.kdl
// kuro is a ThinkPad X12 Detachable Gen 2 docked to a Lenovo Thunderbolt
// 4 Dock with a "TriCreate" 3-monitor arm kit. All 3 external monitors
// are real DisplayPort connectors carried as DP Multi-Stream Transport
// over the single Thunderbolt cable - confirmed via card1-DP-6/8/9 all
// showing "connected" with no udl/evdi module involved anywhere, i.e.
// this was never USB-video/driver territory. An earlier diagnosis on
// this file blamed a driverless Silicon Motion USB-video chip for the
// 3rd (Left) output never showing up - that was wrong. The real cause
// was a bad dock cable preventing full MST negotiation; a good cable
// plus a cold boot brought all three DP streams up cleanly.
//
// Matched by each output's full descriptive name (make/model/serial),
// not by connector (DP-6/8/9) - confirmed live that connector numbers
// reshuffle across sleep/wake and reconnect cycles (seen going from
// DP-9/6/8 to DP-12/7/11 across one dock reconnect), which caused a
// real one-time failure: only 2 of 3 externals came up on first wake
// after docking, all 3 came up only after a logout+wake re-init.
// Matching by name survives that reshuffling instead of depending on
// niri restarting to paper over it.
//
// Internal panel (eDP-1) stays defined below for undocked use, but
// niri only drives outputs that are actually connected, so this
// doesn't force it on while docked.
//
// Lid-close not suspending while docked is expected systemd-logind
// behavior (HandleLidSwitchDocked defaults to "ignore" when unset),
// not a bug - see hosts/kuro/configuration.nix if that default is ever
// worth overriding.
//
// Run `niri msg outputs` (with NIRI_SOCKET set - not exported over a
// plain ssh session, see systemctl --user show-environment) to see
// the live connector/name mapping if the dock or cable ever changes.

output "eDP-1" {
    mode "1920x1280@60.001"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

// Left arm of the 3-monitor kit. Positioned after eDP-1's own slot
// (not at x=0) because eDP-1 stays "connected" at the DRM level even
// with the lid closed/docked - confirmed via
// /sys/class/drm/card1-eDP-1/status still reading "connected" while
// docked - so x=0 y=0 is never actually free to reuse.
output "Invalid Vendor Codename - RTK TriCreate-L T3-DP250813" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=1920 y=0
}

// Middle arm of the 3-monitor kit.
output "PNP(TCK) TriCreate-M T3-HDMI250813" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=3840 y=0
}

// Right arm of the 3-monitor kit.
output "PNP(TCK) TriCreate-R T3-HDMI250813" {
    mode "1920x1080@60.004"
    scale 1.0
    transform "normal"
    position x=5760 y=0
}
